{
    "name": "ldraw-org/library",
    "type": "project",
    "description": "The LDraw.org Library",
    "keywords": [
        "framework",
        "laravel",
        "ldraw",
        "lego"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "blade-ui-kit/blade-icons": "^1.10.1",
        "fico7489/laravel-pivot": "^3.0.3",
        "filament/filament": "^5.7.6",
        "filament/spatie-laravel-media-library-plugin": "^5.7.6",
        "http-interop/http-factory-guzzle": ">=1.2.1",
        "icehouse-ventures/laravel-chartjs": "^5.0.0",
        "lara-zeus/quantity": "^3.0.2",
        "laravel/framework": "^13.24",
        "laravel/head": "^0.1.0",
        "laravel/horizon": "^5.48.2",
        "laravel/pulse": "^1.8.0",
        "laravel/tinker": "^3.0.2",
        "league/flysystem-aws-s3-v3": "^3.35.2",
        "livewire/livewire": "^4.3.5",
        "mailgun/mailgun-php": "^4.5.1",
        "markrogoyski/math-php": "^2.13",
        "panphp/pan": "^0.1.10",
        "postare/blade-mdi": "^1.1.3",
        "sentry/sentry-laravel": "^4.27",
        "spatie/image": "^3.9.5",
        "spatie/laravel-backup": "^10.3.1",
        "spatie/laravel-medialibrary": "^11.23.3",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-settings": "^3.9.0",
        "spatie/temporary-directory": "^2.4.0",
        "staudenmeir/belongs-to-through": "^2.18",
        "staudenmeir/laravel-adjacency-list": "^1.26.1",
        "symfony/http-client": "^8.1.3",
        "symfony/mailgun-mailer": "^8.1.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4.1",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.10.0",
        "laravel/pint": "^1.30.4",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^4.7.8",
        "pestphp/pest-plugin-laravel": "^4.1",
        "spatie/pest-plugin-route-testing": "^1.2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/library_helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
