; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{@APP_ID@}
AppName=LDraw Parts Library
AppVerName=LDraw Parts Library @RELEASE_NAME@
AppPublisher=LDraw.org
AppPublisherURL=http://www.ldraw.org/
AppSupportURL=http://www.ldraw.org/
AppUpdatesURL=http://www.ldraw.org/
DefaultDirName=%CommonDocumentsFolder%\LDraw
DisableProgramGroupPage=yes
OutputBaseFilename=LDrawParts
Compression=lzma2/max
SolidCompression=yes
LicenseFile="complete\ldraw\CAreadme.txt"

[Languages]
Name: "en"; MessagesFile: "compiler:Default.isl"
Name: "de"; MessagesFile: "compiler:Languages\German.isl"
Name: "fr"; MessagesFile: "compiler:Languages\French.isl"
Name: "nl"; MessagesFile: "compiler:Languages\Dutch.isl"
Name: "es"; MessagesFile: "compiler:Languages\Spanish.isl"
Name: "it"; MessagesFile: "compiler:Languages\Italian.isl"
;Name: "po"; MessagesFile: "compiler:Languages\Portuguese.isl"
;Name: "cz"; MessagesFile: "compiler:Languages\Czech.isl"

[CustomMessages]
en.InstallFull=Full installation
de.InstallFull=Vollständige Installation
fr.InstallFull=Installation complète
it.InstallFull=Installazione completa
es.InstallFull=Instalación completa
nl.InstallFull=Volledige installatie

en.CoreLibrary=Core parts library
de.CoreLibrary=Haupt-Bibliothek der Bauteile
fr.CoreLibrary=Bibliothèque de pièces essentielles
it.CoreLibrary=Libreria principale di mattoncini
es.CoreLibrary=Biblioteca de piezas básicas
nl.CoreLibrary=Basisonderdelen

[Types]
Name: "Full"; Description: "{cm:InstallFull}";

[Components]
Name: "Core"; Description: "{cm:CoreLibrary}"; Types: Full; Flags: fixed;

[Files]
Source: "complete\ldraw\*.*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs; Components: Core

[Run]
Filename: "{app}\MKLIST.EXE"; Parameters: "-d"
